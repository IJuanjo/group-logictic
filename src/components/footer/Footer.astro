---
import Logo from "../icons/logo/Logo.astro";
---

<footer class="bg-brand-grayscale-900 text-white">
    <div class="max-w-[1440px] mx-auto px-6 py-12">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px_280px]">
            <div class="space-y-4">
                <Logo class="h-12 w-auto" />
                <p class="max-w-md text-sm text-slate-300">
                    Soluciones integrales en servicios generales y alquiler de
                    máquinas para todos los sectores económicos e industriales.
                </p>
            </div>

            <div>
                <h2
                    class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-400"
                >
                    Servicios
                </h2>
                <ul class="mt-6 space-y-2 text-sm text-slate-300">
                    <li>Alquiler de Máquinas y Equipos</li>
                    <li>Logística y Transporte de Carga</li>
                    <li>Movimiento de Tierras y Excavación</li>
                    <li>Construcción y Mantenimiento de Infraestructura</li>
                    <li>Mantenimiento Preventivo y Correctivo</li>
                    <li>Venta de Artículos EPP</li>
                </ul>
            </div>

            <div>
                <h2
                    class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-400"
                >
                    Contacto
                </h2>
                <div class="mt-6 space-y-3 text-sm text-slate-300">
                    <p>990 523 916 / 901 224 351</p>
                    <p>957 160 080</p>
                    <p>comercial@grupologiccpp.com</p>
                    <p>www.grupologiccpp.com</p>
                    <p>Lima, Perú</p>
                </div>
            </div>
        </div>

        <div
            class="mt-10 border-t border-slate-800 pt-6 text-center text-xs text-slate-500"
        >
            © 2026 Group Logistic CPP S.A.C. Todos los derechos reservados.
        </div>
    </div>
</footer>
