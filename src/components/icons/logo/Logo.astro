---
type Props = {
  class?: string;
  width?: number | string;
  height?: number | string;
};

const { class: className, width = 124, height = 48, ...rest } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  class={className}
  width={width}
  height={height}
  {...rest}
>
  <path fill="url(#a)" d="M0 0h123.2v48H0z"></path>
  <defs>
    <pattern
      id="a"
      width={1}
      height={1}
      patternContentUnits="objectBoundingBox"
    >
      <use xlink:href="#b" transform="scale(.00208 .00535)"></use>
    </pattern>
    <image
      xlink:href="data:image/png;base64,"
      id="b"
      width={480}
      height={187}
      preserveAspectRatio="none"
    />
  </defs>
</svg>
