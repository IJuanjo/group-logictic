---
import { cn } from "tailwind-variants";

interface Props {
    image?: string;
    label?: string;
    description?: string;
    className?: string;
}

const { image, label, description, className = "" } = Astro.props as Props;
---

<div
    class={cn("flex flex-col md:flex-row max-md:px-4 max-w-[1440px] mx-auto my-9  gap-8 items-center", className)}
>
    <img src={image} alt={label} class="rounded-3xl" />
    <div>
        <span class="uppercase text-brand-500">{label}</span>
        <div class="flex flex-col gap-2">
            <slot name="title" />
            <p class="font-family-paragraph max-md:text-sm">{description}</p>
            <slot name="footer" />
        </div>
    </div>
</div>
